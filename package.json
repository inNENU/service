{
  "name": "innenu-service",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/innenu/service.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "debug": "cross-env NODE_ENV=development pnpm build && cross-env NODE_ENV=development node dist/index.js --expose-gc",
    "dev": "tsdown -w",
    "lint": "oxlint --fix --deny-warnings --report-unused-disable-directives && oxfmt",
    "lint:check": "oxlint --deny-warnings --report-unused-disable-directives && oxfmt --check",
    "prepare": "husky",
    "test": "vitest run",
    "test:init-db": "unrun scripts/init-db.ts",
    "test:open": "cross-env TEST_NO_AUTH=1 vitest run __tests__/home __tests__/health __tests__/library __tests__/official __tests__/enroll __tests__/test __tests__/tools",
    "test:provision": "unrun __tests__/provision.ts"
  },
  "devDependencies": {
    "@alicloud/alinlp20200629": "3.1.0",
    "@alicloud/openapi-client": "0.4.15",
    "@mptool/net": "0.14.0",
    "@mptool/parser": "0.16.3",
    "@mr-hope/tsconfig": "0.0.4",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/crypto-js": "4.2.2",
    "@types/express": "5.0.6",
    "@types/express-serve-static-core": "5.1.3",
    "@types/morgan": "1.9.10",
    "@types/node": "24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/qs": "6.15.1",
    "cheerio": "1.2.0",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "cross-env": "10.1.0",
    "crypto-js": "4.2.0",
    "domhandler": "^6.0.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "husky": "9.1.7",
    "iconv-lite": "0.7.3",
    "js-sha1": "0.7.0",
    "morgan": "1.11.0",
    "mysql2": "3.23.2",
    "nano-staged": "1.0.2",
    "oxc-config-hope": "0.3.12",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "picocolors": "1.1.1",
    "qrcode": "1.5.4",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "uuid": "14.0.1",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "nano-staged": {
    "**/*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "oxlint --fix --deny-warnings --report-unused-disable-directives"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.18.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^22.22.0 || ^24.18.0 || ^26.3.0"
  }
}
